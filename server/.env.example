# Copy to server/.env and edit. Environment variables override this file.

# Where the database and keys live (defaults: server/pulsetriage.db and server/keys/)
# PT_DB_PATH=server/pulsetriage.db
# PT_KEYS_DIR=server/keys
PT_PORT=8000

# Public tunnel address for online phones away from the command post, e.g. from
#   cloudflared tunnel --url http://localhost:8000
# PT_PUBLIC_URL=https://example-words.trycloudflare.com

# Development switches: set both to 1 once phones sign and seal (build hours 28-33).
PT_REQUIRE_SIGNATURES=0
PT_REQUIRE_SEALING=0

# Optional: the AI message reader (keyword rules work without it).
# ANTHROPIC_API_KEY=
