                 "Know who nearby may need help to leave"] } },
    "warning": { "en": {
      "headline": "Flood warning for {zones}",
      "do_now": ["Move people and valuables upstairs",
                 "Check on elderly or ill neighbours",
                 "Do not walk or drive through floodwater"] } },
    "emergency": { "en": {
      "headline": "Flood emergency: {zones}. Act now.",
      "do_now": ["Go to the highest floor or roof now",
