{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsetriage.local/schemas/case.schema.json",
  "title": "Case (server to dashboard)",
  "description": "One place or person that needs help. Several reports can merge into one case. Built by the server; the dashboard only reads it.",
  "type": "object",
  "required": ["id", "hazard", "status", "people", "conditions", "details", "points", "reasons", "confidence", "needs", "badges", "report_count", "source", "reader", "reported_at", "last_update"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "hazard": { "enum": ["flood", "heat", "earthquake", "storm", "fire", "landslide", "other"] },
    "status": { "enum": ["new", "verified", "assigned", "en_route", "on_scene", "done", "closed"] },
    "zone": { "type": ["string", "null"] },
    "lat": { "type": ["number", "null"] },
    "lng": { "type": ["number", "null"] },
    "accuracy_m": { "type": ["number", "null"] },
    "landmark": { "type": ["string", "null"] },
    "people": { "type": "integer", "minimum": 1 },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "details": { "type": "object" },
    "hours_left": { "type": ["number", "null"] },
    "window_closes_at": { "type": ["string", "null"] },
    "points": { "type": "integer" },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "points"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "points": { "type": "number", "description": "Points added, or a multiplier when 'kind' is 'trust'." },
          "kind": { "enum": ["time", "vulnerability", "window", "people", "trust", "zone", "override"] }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs": { "type": "array", "items": { "type": "string" } },
    "badges": { "type": "array", "items": { "type": "string" } },
    "team_id": { "type": ["string", "null"] },
    "shelter_id": { "type": ["string", "null"] },
    "report_count": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["app", "alert_reply", "call", "paste", "welfare_check", "silence", "zone_task", "replay"] },
    "reader": { "enum": ["form", "ai", "keywords", "system"] },
    "note": { "type": ["string", "null"] },
    "reported_at": { "type": "string" },
    "last_update": { "type": "string" }
  }
}
