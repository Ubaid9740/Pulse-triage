{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsetriage.local/schemas/payloads/report.schema.json",
  "title": "Report payload (sealed)",
  "description": "A call for help. 'details' holds answers to the questions in common.json and in the hazard's profile, keyed by question id.",
  "type": "object",
  "required": ["hazard", "for_whom", "people", "conditions", "details", "lat", "lng", "reporter_role"],
  "additionalProperties": false,
  "properties": {
    "hazard": { "enum": ["flood", "heat", "earthquake", "storm", "fire", "landslide", "other"] },
    "for_whom": { "enum": ["self", "neighbour", "other"] },
    "people": { "type": "integer", "minimum": 1, "maximum": 500 },
    "conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["elderly", "child", "infant", "pregnant", "cannot_walk", "disabled", "oxygen", "dialysis", "insulin",
                 "power_dependent", "other_medicine", "injured", "bleeding", "unconscious", "alone", "no_food_water"]
      }
    },
    "details": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,40}$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "boolean" },
          { "type": "string", "maxLength": 40 },
          { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 20 },
          { "type": "null" }
        ]
      }
    },
    "note": { "type": "string", "maxLength": 500 },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "gps_accuracy_m": { "type": ["number", "null"], "minimum": 0 },
    "landmark": { "type": "string", "maxLength": 200 },
    "reporter_role": { "enum": ["helper", "volunteer", "rescue_team", "call_taker"] },
    "contact": { "type": "string", "maxLength": 40 },
    "alert_id": { "type": ["string", "null"], "description": "Set when the report came from 'I need help' on an alert." },
    "registry_id": { "type": ["string", "null"] }
  }
}
