{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsetriage.local/schemas/payloads/revoke.schema.json",
  "title": "Revoke payload (public, signed by the command post)",
  "description": "Devices that must no longer be trusted, e.g. a stolen team phone.",
  "type": "object",
  "required": ["device_ids", "reason"],
  "additionalProperties": false,
  "properties": {
    "device_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "reason": { "type": "string", "maxLength": 200 }
  }
}
